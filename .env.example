# API root must include /api/v1 (backend version prefix). Production: HTTPS origin only.
# Android emulator: use http://10.0.2.2:8000/api/v1 instead of localhost when needed.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# false = real backend (required for production builds). Mock runs only in __DEV__ when true.
EXPO_PUBLIC_USE_MOCK_AUTH=false

# Security: never put secrets here — only EXPO_PUBLIC_* is embedded in the app bundle.
# Web: access JWT stays in memory; refresh uses HttpOnly cookie from the API.
# Dev (auto-refresh UI): cd frontend && npm run dev:web → http://localhost:8081 — edit files, browser updates via Fast Refresh.
# Prod-like static (no reload): cd frontend/deploy && docker compose up --build → http://localhost:8088 — rebuild after changes.
# Optional dev in Docker: cd frontend/deploy && docker compose -f docker-compose.dev.yml up --build

# Demo customer sign-in: demo@poultech.in / Poultech123
# Demo poultry owner sign-in: owner@poultech.in / PoultechOwner123
# Demo admin sign-in: admin@poultech.in / PoultechAdmin123
# Google Sign-In (Web) — OAuth **Web client** ID only (public). Never put client_secret here.
# Must match backend GOOGLE_CLIENT_ID. Full form: 125224829726-xxxx.apps.googleusercontent.com
#
# Copy each EXPO_PUBLIC_GOOGLE_JS_ORIGINS value into Google Console → Authorized JavaScript origins (one URI per line there).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Comma-separated — used for error hints; register the same hosts in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_JS_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
# Primary web origin for this deployment (dev :8088 or prod https://your-domain)
EXPO_PUBLIC_APP_WEB_ORIGIN=http://127.0.0.1:8088
# Redirect flow (native / legacy web only); GIS web build usually ignores this.
EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# OAuth consent screen: Testing + test users until the app is verified.
