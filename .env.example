# Copy to `frontend/.env` and restart the dev container (no image rebuild for TS edits).
#
# API root must include /api/v1 (backend version prefix). Production: HTTPS origin only.
# Expo web (:8081): point at the API directly.
# Docker static (:8088): leave unset or use EXPO_PUBLIC_WEB_API_URL=/api/v1 so nginx proxies same-origin.
# Android emulator: use http://10.0.2.2:8000/api/v1 instead of localhost when needed.
# Baked in at `expo export` / Docker web build — changing .env alone does not update :8088 until rebuild.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# false = real backend + live egg/culls/broiler from API. true = demo login + static market cards.
EXPO_PUBLIC_USE_MOCK_AUTH=false

# Security: never put secrets here — only EXPO_PUBLIC_* is embedded in the app bundle.
# Dev (Fast Refresh): cd frontend && npm run dev:web → http://localhost:8081
# Docker live UI (no rebuild per save): cd frontend/deploy && docker compose -f docker-compose.dev.yml up -d → http://localhost:8088
# Static snapshot only: cd frontend/deploy && docker compose up --build → http://localhost:8088

# Demo logins (only when EXPO_PUBLIC_USE_MOCK_AUTH=true): demo@poultech.in / Poultech123, etc.

# Google Sign-In (Web) — public Web client ID only. Must match backend GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Register every origin below in Google Console → Web client → Authorized JavaScript origins.
EXPO_PUBLIC_GOOGLE_JS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8088,http://127.0.0.1:8088
# Where you open the app in the browser (8081 = dev:web, 8088 = Docker static).
EXPO_PUBLIC_APP_WEB_ORIGIN=http://localhost:8081
# Native / redirect flow only (optional on web GIS).
EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=