# Template for local Docker static web (:8088). Copy to `.env.production` or merge into `frontend/.env`.
# Add your Google Web client ID from Google Cloud (must match backend GOOGLE_CLIENT_ID).

EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_USE_MOCK_AUTH=false

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_JS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
EXPO_PUBLIC_APP_WEB_ORIGIN=http://127.0.0.1:8088
EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=http://127.0.0.1:8088
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=