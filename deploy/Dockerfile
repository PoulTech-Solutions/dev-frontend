# Build the Expo web app, then serve it with nginx.
# Use this later on any VPS / cloud server — no change to the app required.

FROM node:22-alpine AS build
WORKDIR /app
ARG EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
ARG EXPO_PUBLIC_USE_MOCK_AUTH=false
ARG EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
ARG EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=
ARG EXPO_PUBLIC_GOOGLE_JS_ORIGINS=
ARG EXPO_PUBLIC_APP_WEB_ORIGIN=
ARG EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
ARG EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_USE_MOCK_AUTH=$EXPO_PUBLIC_USE_MOCK_AUTH
ENV EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=$EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
ENV EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=$EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI
ENV EXPO_PUBLIC_GOOGLE_JS_ORIGINS=$EXPO_PUBLIC_GOOGLE_JS_ORIGINS
ENV EXPO_PUBLIC_APP_WEB_ORIGIN=$EXPO_PUBLIC_APP_WEB_ORIGIN
ENV EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=$EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID
ENV EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=$EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npx expo export --platform web

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
