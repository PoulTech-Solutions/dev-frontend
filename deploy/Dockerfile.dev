# Development only — Metro + Expo web with hot reload. Bind-mounts source in compose.
# Rebuild this image when package.json / package-lock.json changes. TS/TSX edits do not need --build.
FROM node:22-alpine
WORKDIR /app
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true
COPY package.json package-lock.json* ./
RUN npm install
EXPOSE 8081
CMD ["sh", "-c", "npm install && npx expo start --web --host 0.0.0.0 --port 8081"]