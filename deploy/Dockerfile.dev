# Development only — Metro + Expo web with hot reload. Bind-mounts source in compose.
# Rebuild this image when package.json / package-lock.json changes. TS/TSX edits do not need --build.
FROM node:22-alpine
WORKDIR /app
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true
COPY package.json package-lock.json* ./
RUN npm install
EXPOSE 8081
# Expo 54+ only accepts --host lan|tunnel|localhost (not 0.0.0.0); lan binds for Docker nginx upstream.
CMD ["sh", "-c", "npm install && npx expo start --web --host lan --port 8081"]